{
    "require": {
        "endroid/qr-code": "^6.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "squizlabs/php_codesniffer": "^3.11",
        "phpstan/phpstan": "^2.1",
        "php-stubs/wordpress-stubs": "^6.7",
        "wp-coding-standards/wpcs": "^3.1"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "platform-check": false
    },
    "name": "qrip/wordpress-plugin",
    "description": "First-party editable QR redirects for WordPress.",
    "license": ["proprietary"],
    "scripts": {
        "test": "phpunit",
        "lint": "find . -path ./vendor -prune -o -name '*.php' -print0 | xargs -0 -n1 php -l",
        "phpstan": "phpstan analyse --no-progress --configuration=phpstan.neon.dist"
    }
}
